{
  "expo": {
    "name": "Blaze",
    "slug": "blaze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "blaze",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blazefit.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A1A"
      },
      "package": "com.blazefit.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Blaze needs camera access for real-time form detection during workouts."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Blaze needs camera access for real-time form detection during workouts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B35"
        }
      ],
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Blaze to access the microphone for hands-free workout voice commands.",
          "speechRecognitionPermission": "Allow Blaze to transcribe your voice commands (like 'pause', 'resume') during workouts.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.samsung.android.bixby.agent",
            "com.samsung.android.honeyboard",
            "com.miui.voiceassist",
            "com.xiaomi.mibrain.speech"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c527c733-0a04-4ef0-b30d-b8d3c2881b61"
      }
    },
    "owner": "murugan_7"
  }
}
